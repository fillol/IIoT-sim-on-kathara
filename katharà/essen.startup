ip link set dev eth0 up
ip link set dev eth1 up

# eth0 -> duesseldorf
tc qdisc add dev eth0 root tbf rate 2.048649MBps burst 32kbit latency 400ms
# eth1 -> dortmund
tc qdisc add dev eth1 root tbf rate 94.432367MBps burst 32kbit latency 400ms

ip addr add 10.0.0.94/30 dev eth0
ip addr add 10.0.0.97/30 dev eth1

ip route add 10.255.255.1/32 via 10.0.0.98