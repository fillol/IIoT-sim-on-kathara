ip link set dev eth0 up
ip link set dev eth1 up
ip link set dev eth2 up
ip link set dev eth3 up

# eth0 -> hannover
tc qdisc add dev eth0 root tbf rate 19.10228MBps burst 32kbit latency 400ms
# eth1 -> berlin
tc qdisc add dev eth1 root tbf rate 8.055542MBps burst 32kbit latency 400ms
# eth2 -> frankfurt
tc qdisc add dev eth2 root tbf rate 266.784555MBps burst 32kbit latency 400ms
# eth3 -> nuernberg
tc qdisc add dev eth3 root tbf rate 4.16884MBps burst 32kbit latency 400ms

ip addr add 10.0.0.30/30 dev eth0
ip addr add 10.0.0.42/30 dev eth1
ip addr add 10.0.0.45/30 dev eth2
ip addr add 10.0.0.49/30 dev eth3