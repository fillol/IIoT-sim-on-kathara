ip link set dev eth0 up
ip link set dev eth1 up
ip link set dev eth2 up
ip link set dev eth3 up

# eth0 -> norden
tc qdisc add dev eth0 root tbf rate 0.057032MBps burst 32kbit latency 400ms
# eth1 -> hannover
tc qdisc add dev eth1 root tbf rate 56.907684MBps burst 32kbit latency 400ms
# eth2 -> essen
tc qdisc add dev eth2 root tbf rate 6.527796MBps burst 32kbit latency 400ms
# eth3 -> koeln
tc qdisc add dev eth3 root tbf rate 15.041214MBps burst 32kbit latency 400ms

ip addr add 10.0.0.6/30 dev eth0
ip addr add 10.0.0.38/30 dev eth1
ip addr add 10.0.0.98/30 dev eth2
ip addr add 10.0.0.101/30 dev eth3

ip route add 10.255.255.1/32 via 10.0.0.37
ip route add 10.0.0.92/30 via 10.0.0.97